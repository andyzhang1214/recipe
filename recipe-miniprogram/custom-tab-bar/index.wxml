<view class="tabbar t-{{theme}} bg-{{skinBg}}"
      style="padding-left: {{padX}}px; padding-right: {{padX}}px; padding-bottom: {{padBottom}}px;">
  <view class="bar {{barDark ? 'bar-dark' : ''}}"
        style="padding-bottom: {{barPadBottom}}px; {{barBg ? 'background: ' + barBg + ';' : ''}}">
    <view class="tb-item {{selected === index ? 'on' : ''}}" wx:for="{{list}}" wx:key="path"
          data-path="{{item.path}}" bindtap="switchTab">
      <view class="tb-ic-box"><view class="tb-ic ic-{{item.icon}}"></view></view>
      <view class="tb-txt">{{item.text}}</view>
    </view>
  </view>
</view>
