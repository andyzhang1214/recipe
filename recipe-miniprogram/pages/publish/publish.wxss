/* 发布 */
/* 底部内容预留：tabBar 让位(100rpx+safe-area) + 间距（footer 已在内容流末尾） */
.form-content { padding-bottom: 200rpx; }
.label { font-size: 26rpx; color: var(--sub); margin: 26rpx 0 14rpx; font-weight: 500; }

/* 展示图多选网格（2 列，最多4张） */
.cover-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.cover-cell {
  position: relative;
  width: 212rpx;
  height: 212rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
}
.cover-img { width: 100%; height: 100%; }
.cover-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 52rpx;
  height: 52rpx;
  background: rgba(30, 18, 8, 0.6);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-left-radius: 22rpx;
}
.cover-add {
  background: var(--accent-grad-soft);
  border: 2rpx dashed var(--accent);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.cover-ph { color: var(--accent); font-size: 52rpx; line-height: 1; }
.cover-ph-tip { color: var(--accent); font-size: 24rpx; opacity: 0.85; }

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 26rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  letter-spacing: 1rpx;
}
.add { color: var(--accent); font-size: 27rpx; font-weight: 600; }
/* 标题+副标签归组左侧：避免 space-between 下三元素把副标签挤到行中间 */
.sec-left { display: flex; align-items: baseline; gap: 12rpx; min-width: 0; }
.sec-tip { color: var(--sub); font-size: 22rpx; font-weight: 400; letter-spacing: 0; }

.ing-row { display: flex; gap: 16rpx; margin-bottom: 18rpx; align-items: center; }
.ing-name { flex: 1; min-width: 0; height: 92rpx; line-height: 44rpx; box-sizing: border-box; padding: 24rpx 30rpx; }
.ing-amount { flex: 1; min-width: 0; box-sizing: border-box; height: 92rpx; line-height: 44rpx; padding: 24rpx 30rpx; }
/* 食材克数：数字输入框 + 固定"克"后缀 */
.ing-grams { position: relative; width: 220rpx; flex-shrink: 0; }
.grams-input { width: 100%; box-sizing: border-box; height: 92rpx; line-height: 44rpx; padding: 24rpx 64rpx 24rpx 30rpx; }
.grams-unit {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  color: var(--sub);
}
.del { color: var(--sub); padding: 0 8rpx; font-size: 30rpx; }

/* 食材名称联想：命中热量库的可选胶囊 */
.suggest-wrap { display: flex; flex-wrap: wrap; gap: 14rpx; margin: -6rpx 0 20rpx; }
.suggest-chip {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  background: var(--accent-weak);
  border: 1rpx solid var(--accent);
}
.suggest-chip:active { opacity: 0.75; }
.sg-name { color: var(--text); font-size: 26rpx; font-weight: 600; }
.sg-cal { color: var(--sub); font-size: 20rpx; }

/* 步骤块：卡片化 */
.step-item { margin-bottom: 28rpx; }
.step-box {
  background: var(--card2);
  border-radius: var(--radius-card);
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}
.step-head { margin-bottom: 18rpx; }
.step-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 30rpx;
  border-radius: var(--radius-tag);
  background: var(--accent-grad-soft);
  color: var(--accent);
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 大图上传区：整块可点，无图时虚线大框 */
.step-img-box {
  width: 100%;
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 18rpx;
  border: 2rpx dashed rgba(232, 100, 62, 0.4);
  background: var(--card);
}
.step-img-box.has { border: none; background: none; }
.step-img { width: 100%; height: 320rpx; display: block; }
.step-img-ph {
  height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.step-img-plus { color: var(--accent); font-size: 64rpx; line-height: 1; }
.step-img-tip { color: var(--sub); font-size: 26rpx; }

.step-text {
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  background: var(--card);
}
.step-seasoning {
  width: 100%;
  height: 104rpx;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  line-height: 60rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
  background: var(--card);
}
.step-tools { display: flex; align-items: center; gap: 16rpx; }
/* 同步食材行规格：border-box 定高，避免 content-box 下 padding 撑高 */
.step-time { flex: 1; height: 92rpx; line-height: 44rpx; box-sizing: border-box; padding: 24rpx 30rpx; background: var(--card); }

/* 删除步骤：独立一行放步骤块最下面，危险弱色整行可点 */
.step-del-row {
  margin-top: 20rpx;
  height: 76rpx;
  border-radius: var(--radius-sm);
  background: var(--danger-weak, rgba(217, 48, 37, 0.10));
  color: var(--danger, #e64340);
  font-size: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
}
.step-del-row:active { opacity: 0.7; }

/* 添加步骤按钮（步骤列表末尾整块） */
.step-add {
  margin-top: 8rpx;
  height: 96rpx;
  border-radius: var(--radius-card);
  border: 2rpx dashed var(--accent);
  background: var(--accent-grad-soft);
  color: var(--accent);
  font-size: 29rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-weight: 600;
}
.step-add-plus { font-size: 38rpx; }

/* footer 改为内容流末尾（不再 fixed 锁屏），位于所有步骤之后 */
.footer { margin-top: 44rpx; padding: 0 0 24rpx; display: flex; gap: 20rpx; }
.footer .btn { flex: 1; }
.draft { background: var(--card2); color: var(--text); border: none; line-height: 92rpx; }

/* 可见范围 3 按钮 */
.vis-btns {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.vis-btn {
  flex: 1;
  height: 92rpx;
  border-radius: var(--radius-card);
  background: var(--fill);
  color: var(--text);
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.18s ease;
  font-weight: 500;
}
.vis-btn.active {
  background: var(--accent-grad);
  color: var(--btn-text);
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx var(--glow);
}
.vis-tip {
  font-size: 24rpx;
  color: var(--accent);
  text-align: center;
  margin-top: 10rpx;
  font-weight: 500;
}

/* 队伍分享设置：全部队伍开关 + 指定队伍多选胶囊 */
.share-teams { margin-top: 24rpx; }
.share-all {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background: var(--fill);
}
.sa-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 3rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: transparent;
  flex-shrink: 0;
  transition: all 0.15s ease;
}
.sa-check.on {
  background: var(--accent-grad);
  border-color: transparent;
  color: var(--btn-text);
  box-shadow: 0 6rpx 16rpx var(--glow);
}
.sa-main { flex: 1; min-width: 0; }
.sa-name { font-size: 28rpx; font-weight: 700; color: var(--text); }
.sa-desc { font-size: 22rpx; color: var(--sub); margin-top: 4rpx; }
.team-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}
.team-chip {
  padding: 16rpx 30rpx;
  border-radius: var(--radius-tag);
  background: var(--fill);
  border: 2rpx solid var(--border);
  font-size: 25rpx;
  color: var(--text);
  transition: all 0.15s ease;
}
.team-chip.on {
  background: var(--accent-grad);
  border-color: transparent;
  color: var(--btn-text);
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx var(--glow);
}
.chips-empty { font-size: 24rpx; color: var(--sub); }
