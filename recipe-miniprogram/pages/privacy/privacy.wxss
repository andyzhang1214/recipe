.page {
  min-height: 100vh;
  padding: 0 0 80rpx;
  box-sizing: border-box;
  color: var(--text, #333);
}
.container {
  max-width: 720rpx;
  margin: 0 auto;
  padding: 32rpx 24rpx 0;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  font-family: var(--font-title, inherit);
  text-align: center;
  margin: 24rpx 0 8rpx;
}
.subtitle {
  font-size: 24rpx;
  opacity: 0.6;
  text-align: center;
  margin-bottom: 48rpx;
}
.section {
  margin-bottom: 32rpx;
}
.h2 {
  font-size: 30rpx;
  font-weight: 600;
  margin: 24rpx 0 12rpx;
}
.h3 {
  font-size: 28rpx;
  font-weight: 600;
  margin: 16rpx 0 8rpx;
}
.p {
  font-size: 28rpx;
  line-height: 1.8;
  margin-bottom: 12rpx;
}
.li {
  font-size: 28rpx;
  line-height: 1.8;
  padding-left: 8rpx;
}
.footer {
  font-size: 24rpx;
  opacity: 0.6;
  text-align: center;
  margin-top: 48rpx;
}
