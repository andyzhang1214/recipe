/* 队伍详情 */
.page-content { padding-bottom: 80rpx; }

/* ===== 顶部横幅：粉彩渐变贴纸 + 头像 + 人数 ===== */
.cd-hero {
  position: relative;
  background: linear-gradient(135deg, var(--accent-weak) 0%, var(--card) 55%, var(--ok-weak) 100%);
  border-radius: var(--radius-card);
  border: var(--card-outline);
  box-shadow: var(--shadow);
  padding: 40rpx 36rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
/* 贴纸装饰圆：可爱风为可可勾边白圈，其余主题近似隐形 */
.cd-hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  border: var(--card-outline);
}
.cd-hero-deco.d1 { right: -56rpx; top: -56rpx; width: 220rpx; height: 220rpx; }
.cd-hero-deco.d2 { left: 140rpx; bottom: -84rpx; width: 180rpx; height: 180rpx; background: rgba(255, 255, 255, 0.40); }
.cd-hero-row { position: relative; display: flex; align-items: center; gap: 28rpx; }
.cd-avatar-box { position: relative; flex-shrink: 0; }
.cd-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  border: 6rpx solid #FFFFFF;
  box-shadow: var(--shadow-sm);
  display: block;
}
.cd-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  font-family: var(--font-title);
  color: var(--accent);
  background: #FFFFFF;
}
.cd-role-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  background: var(--star);
  color: var(--text);
  font-size: 19rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: var(--card-outline);
  white-space: nowrap;
}
.cd-hero-info { flex: 1; min-width: 0; }
.cd-count { display: flex; align-items: baseline; gap: 6rpx; }
.cd-count-icon { font-size: 28rpx; }
.cd-count-num {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--text);
  font-family: 'DIN Alternate', -apple-system, 'PingFang SC', sans-serif;
  line-height: 1;
}
.cd-count-cap { font-size: 24rpx; color: var(--sub); font-weight: 600; }
.cd-hero-bar {
  margin-top: 20rpx;
  width: 100%;
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: var(--card-outline);
  overflow: hidden;
}
.cd-hero-bar-in { height: 100%; border-radius: 999rpx; background: var(--accent-grad); }

/* ===== banner 内集成功能按钮 ===== */
.cd-hero-divider {
  margin-top: 28rpx;
  border-top: 2rpx dashed var(--border);
  position: relative;
}
.cd-hero-acts {
  position: relative;
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.cd-act {
  flex: 1;
  height: 76rpx;
  border-radius: var(--radius-md);
  background: var(--card);
  border: var(--card-outline);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}
.cd-act.main {
  flex: 1.25;
  background: var(--btn-primary-bg);
  color: var(--btn-primary-text);
  border: var(--btn-primary-border);
  box-shadow: var(--btn-primary-shadow);
}
.cd-act-ic { font-size: 27rpx; line-height: 1; }
.cd-act-tx { font-size: 25rpx; font-weight: 700; color: inherit; }
.cd-act:not(.main) .cd-act-tx { color: var(--text); }
.cd-act-press { transform: scale(0.96); opacity: 0.85; }

/* ===== 邀请成员弹层：卡片/分段/票据样式统一在 app.wxss（与冰箱页共用） ===== */

/* ===== 设置弹层：头像选择 + 解散区 ===== */
.av-picker { display: flex; justify-content: center; margin: 8rpx 0 20rpx; }
.av-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 4rpx solid var(--card);
  box-shadow: var(--shadow);
}
.av-ph {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  border: 3rpx dashed var(--accent);
  background: var(--accent-grad-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.av-plus { font-size: 44rpx; color: var(--accent); font-weight: 600; line-height: 1; }
.av-tip { font-size: 21rpx; color: var(--sub); }
.dissolve-zone { margin-top: 40rpx; padding-top: 32rpx; border-top: 2rpx solid var(--border); }
.dissolve-btn {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--danger);
  background: var(--danger-weak);
  border: 2rpx solid rgba(214, 80, 74, 0.28);
  border-radius: var(--radius-btn);
  padding: 22rpx 0;
}
.dissolve-tip { font-size: 21rpx; color: var(--sub); text-align: center; margin-top: 14rpx; line-height: 1.6; }

/* ===== 成员头像（真图优先，字符兜底） ===== */
.m-avatar-box { position: relative; flex-shrink: 0; }
.m-avatar-img {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: block;
}
.op {
  font-size: 26rpx;
  color: var(--accent);
  padding: 12rpx 30rpx;
  border: 2rpx solid var(--accent);
  border-radius: var(--radius-btn);
  background: transparent;
  line-height: 1.4;
  font-weight: 500;
}
.op::after { border: none; }
.op.ok { color: var(--ok); border-color: var(--ok); background: var(--ok-weak); border: none; }
.op.no { color: var(--danger); border-color: var(--danger); background: var(--danger-weak); border: none; }
.op.share { color: var(--btn-text); background: var(--accent-grad); border-color: transparent; font-size: 25rpx; padding: 8rpx 26rpx; box-shadow: 0 6rpx 18rpx var(--glow); }

.member { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--border); }
.member:last-child { border-bottom: none; }
.m-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--accent-grad-soft);
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.m-main { flex: 1; min-width: 0; }
.m-name { font-size: 29rpx; color: var(--text); font-weight: 500; display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.m-ops { display: flex; gap: 12rpx; flex-shrink: 0; }

.invite { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid var(--border); }
.i-info { flex: 1; min-width: 0; margin-right: 16rpx; }
.i-token { font-size: 29rpx; font-weight: 700; color: var(--text); font-family: 'JetBrains Mono', monospace; letter-spacing: 1rpx; }
.i-meta { font-size: 22rpx; color: var(--sub); margin-top: 6rpx; }

.sheet-title { font-size: 34rpx; font-weight: 700; color: var(--text); text-align: center; margin-bottom: 32rpx; }
.sheet-label { font-size: 26rpx; color: var(--sub); margin: 28rpx 0 16rpx; font-weight: 500; }
.sheet-btn { width: 100%; margin-top: 40rpx; }
.switch-row { display: flex; align-items: center; justify-content: space-between; }
.switch-tip { font-size: 26rpx; color: var(--text); }
.sheet-tip { font-size: 24rpx; color: var(--sub); margin: 8rpx 0 24rpx; line-height: 1.6; }

/* ===== 心愿单 ===== */
.wish-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.wish-title {
  font-size: 33rpx;
  font-weight: 700;
  color: var(--text);
  display: flex;
  align-items: center;
  letter-spacing: 1rpx;
}
.wish-dot {
  width: 12rpx;
  height: 34rpx;
  border-radius: 6rpx;
  background: var(--accent-grad);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.wish-add {
  font-size: 26rpx;
  color: var(--accent);
  font-weight: 600;
  background: var(--accent-grad-soft);
  border-radius: var(--radius-btn);
  padding: 12rpx 28rpx;
}
.wish-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--card2);
  border-radius: var(--radius-md);
  padding: 22rpx 26rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}
/* 菜名区占约 2/3，按钮收在右侧 */
.wish-info { flex: 1; min-width: 0; }
.wish-dish {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wish-by { font-size: 22rpx; color: var(--sub); margin-top: 8rpx; }
.wish-note { font-size: 22rpx; color: var(--text); opacity: 0.7; margin-top: 6rpx; }
.wish-ops { display: flex; flex-direction: column; align-items: stretch; gap: 12rpx; flex-shrink: 0; width: 176rpx; }
.wish-btn {
  width: 100%;
  height: 60rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  padding: 0;
  border-radius: var(--radius-btn);
  display: flex;
  align-items: center;
  justify-content: center;
}
.wish-btn::after { border: none; }
.wish-btn.go { background: var(--accent-grad); color: var(--btn-text); box-shadow: 0 6rpx 16rpx var(--glow); }
.wish-btn.skip { background: var(--fill); color: var(--sub); }

/* ===== 圈员菜品 ===== */
.fr-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.fr-item:last-child { border-bottom: none; }
.fr-cover {
  width: 110rpx;
  height: 110rpx;
  border-radius: var(--radius-md);
  background: var(--fill);
  flex-shrink: 0;
}
.fr-info { flex: 1; min-width: 0; }
.fr-title {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fr-meta { font-size: 22rpx; color: var(--sub); margin-top: 10rpx; }
.chevron { color: var(--sub); font-size: 44rpx; opacity: 0.5; }
.empty.small { padding: 40rpx 0; font-size: 24rpx; }
