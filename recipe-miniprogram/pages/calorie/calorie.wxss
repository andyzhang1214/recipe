/* 热量查询 · 搜索行同方案A：输入框整行 + 右端内嵌圆钮 */
.search-row { padding: 20rpx 28rpx 8rpx; }
.search-wrap {
  display: flex;
  align-items: center;
  background: var(--fill);
  border-radius: 999rpx;
  padding: 0 12rpx 0 30rpx;
  height: 84rpx;
  border: 1rpx solid transparent;
}
.page.theme-cute .search-wrap {
  background: var(--card);
  border: var(--card-outline);
  box-shadow: var(--shadow-sm);
}
.page.theme-clean .search-wrap {
  background: var(--card);
  border: var(--card-outline);
  border-radius: var(--radius-input);
}
.search-icon {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid var(--sub);
  border-radius: 50%;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.search-icon::after {
  content: '';
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 11rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--sub);
  transform: rotate(45deg);
}
.search { flex: 1; background: transparent; border: none; padding: 0; height: 100%; min-width: 0; }

/* 内嵌圆钮：60rpx，空输入时弱化 45% */
.go-btn {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: var(--btn-primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx var(--glow);
  transition: opacity 0.15s ease;
}
.go-press { transform: scale(0.9); }
.go-btn.dim { opacity: 0.45; box-shadow: none; }
.page.theme-cute .go-btn { border: 3rpx solid #4E2B36; box-shadow: 3rpx 3rpx 0 rgba(78, 43, 54, 0.16); }
.page.theme-cute .go-btn.dim { box-shadow: none; }
.page.theme-clean .go-btn { border-radius: 12rpx; box-shadow: none; }

/* 圆钮内的白色放大镜 */
.go-ic {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #FFFFFF;
  border-radius: 50%;
  box-sizing: border-box;
}
.go-ic::after {
  content: '';
  position: absolute;
  right: -8rpx;
  bottom: -5rpx;
  width: 12rpx;
  height: 5rpx;
  border-radius: 5rpx;
  background: #FFFFFF;
  transform: rotate(45deg);
}

.cats { display: flex; gap: 16rpx; margin: 26rpx 28rpx 10rpx; }
.cat {
  padding: 12rpx 36rpx;
  border-radius: var(--radius-tag);
  background: var(--card);
  color: var(--sub);
  font-size: 27rpx;
  box-shadow: var(--shadow-sm);
  font-weight: 500;
  border: 2rpx solid transparent;
  transition: all 0.18s ease;
}
.cat.active { background: var(--accent-grad); color: var(--btn-text); font-weight: 600; box-shadow: 0 8rpx 22rpx var(--glow); }

/* 结果卡片网格：双列（space-between 吸收亚像素舍入，同冰箱页），卡内纵向排名称/规格/热量 */
.food-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 8rpx 28rpx 0;
}
.food-card {
  width: calc(50% - 12rpx);
  margin-bottom: 24rpx;
  box-sizing: border-box;
  background: var(--card);
  border-radius: var(--radius-card);
  border: var(--card-outline);
  box-shadow: var(--shadow-sm);
  padding: 24rpx 24rpx 26rpx;
}
.food-top { display: flex; align-items: flex-start; justify-content: space-between; }
.food-name {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.food-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--sub);
  background: var(--fill);
  border-radius: 999rpx;
  padding: 5rpx 14rpx;
  margin-left: 12rpx;
}
.food-remark {
  font-size: 22rpx;
  color: var(--sub);
  margin-top: 10rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.kcal {
  margin-top: 20rpx;
  text-align: center;
  background: var(--accent-grad-soft);
  border-radius: var(--radius-md);
  padding: 18rpx 0 16rpx;
  color: var(--accent);
}
.kcal-num {
  font-size: 44rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.kcal-unit { display: block; font-size: 19rpx; margin-top: 8rpx; font-weight: 500; opacity: 0.75; }
/* 热量分级色 */
.kcal.k-high { color: var(--danger); background: var(--danger-weak); }
.kcal.k-mid { color: var(--warn); background: var(--warn-weak); }
.kcal.k-low { color: var(--ok); background: var(--ok-weak); }

/* 热量图例 */
.legend {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 8rpx 0 24rpx;
}
.lg {
  font-size: 22rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-tag);
}
.lg-high { color: var(--danger); background: var(--danger-weak); }
.lg-mid { color: var(--warn); background: var(--warn-weak); }
.lg-low { color: var(--ok); background: var(--ok-weak); }
