/* 工具 */
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22rpx;
  padding-top: 12rpx;
}
.tool-card {
  background: var(--card);
  border-radius: var(--radius-card);
  padding: 40rpx 12rpx 32rpx;
  box-shadow: var(--shadow);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
  border: var(--card-outline);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tool-card.pressed { transform: scale(0.94); box-shadow: var(--shadow-sm); }
.icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-card);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
  box-shadow: var(--shadow);
}
.icon { font-size: 46rpx; }
/* 每个工具专属渐变 */
.icon-wrap.calorie { background: linear-gradient(135deg, #FFB27A, #F0783E); }
.icon-wrap.fridge { background: linear-gradient(135deg, #8FC4E8, #4E86B8); }
.icon-wrap.timer { background: linear-gradient(135deg, #A8D39A, #5E9E4E); }
.name { font-size: 30rpx; font-weight: 700; color: var(--text); letter-spacing: 1rpx; }
.desc { font-size: 20rpx; color: var(--sub); margin-top: 10rpx; line-height: 1.5; }
