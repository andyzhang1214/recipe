<view class="page theme-{{theme}} bg-{{skinBg}}" style="{{bgStyle}}">
  <nav-bar title="工具" theme="{{theme}}" />
  <view class="page-content">
    <view class="page-header header-only-sub">
      <view class="h-sub">热量、冰箱、计时，做菜的好帮手</view>
    </view>
    <view class="grid">
      <view class="tool-card" wx:for="{{tools}}" wx:key="key" data-idx="{{index}}" bindtap="onToolTap" hover-class="pressed">
        <view class="icon-wrap {{item.key}}">
          <text class="icon">{{item.icon}}</text>
        </view>
        <view class="name">{{item.name}}</view>
        <view class="desc">{{item.desc}}</view>
      </view>
    </view>
  </view>
  <login-popup id="login-popup" bindlogined="onLogined" />
</view>
