<view class="page theme-{{theme}} bg-{{skinBg}}" style="{{bgStyle}}">
  <nav-bar title="{{navTitle}}" back="{{true}}" theme="{{theme}}" />
  <block wx:if="{{recipe && steps.length > 0}}">
  <!-- 步骤进度 -->
  <view class="progress-wrap">
    <view class="progress-text">第 {{current + 1}} / {{steps.length}} 步</view>
    <view class="progress-track">
      <view class="progress-bar" style="width: {{(current + 1) / steps.length * 100}}%;"></view>
    </view>
  </view>

  <view class="step-card">
    <view class="step-no">{{current + 1}}</view>
    <view class="step-text">{{steps[current].text}}</view>
    <image wx:if="{{steps[current].image}}" class="step-img" src="{{steps[current].image}}" mode="aspectFill" lazy-load />

    <!-- 步骤内联计时组件：有建议时长才展示 -->
    <cook-timer wx:if="{{steps[current].durationSec && steps[current].durationSec > 0}}"
                duration-sec="{{steps[current].durationSec}}" step-index="{{current}}" />
  </view>

  <view class="nav">
    <button class="btn btn-plain" bindtap="prev" disabled="{{current === 0}}">上一步</button>
    <button class="btn btn-primary" bindtap="next">{{current === steps.length - 1 ? '完成' : '下一步'}}</button>
  </view>
  <view class="timer-link" bindtap="startTimer">⏱ 需要更多时间？去独立计时器</view>
  </block>
</view>
