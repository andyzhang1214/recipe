/* 登录弹层 */

/* 静默登录检测中 */
.checking {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 30rpx;
}
.spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid var(--fill);
  border-top-color: var(--accent);
  animation: spin 0.8s linear infinite;
  margin-bottom: 28rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.checking-text {
  font-size: 28rpx;
  color: var(--sub);
  letter-spacing: 2rpx;
}
.mask {
  position: fixed;
  inset: 0;
  background: rgba(30, 20, 12, 0.5);
  z-index: 999;
}

.popup {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: var(--card, #ffffff);
  border-radius: var(--radius-card);
  padding: 60rpx 52rpx 38rpx;
  z-index: 1000;
  box-sizing: border-box;
  box-shadow: var(--shadow-lg);
  animation: pop 0.28s cubic-bezier(0.32, 0.72, 0, 1);
  /* 全部子元素水平居中，内容整体垂直堆叠 */
  display: flex;
  flex-direction: column;
  align-items: center;
}
@keyframes pop {
  from { transform: translate(-50%, -48%) scale(0.92); opacity: 0; }
  to { transform: translate(-50%, -50%) scale(1); opacity: 1; }
}

.popup.theme-light { --card: #FFFFFF; --text: #2F2A26; --sub: #8B7F73; --accent: #E8643E; --btn-text: #FFF; --fill: rgba(120,100,80,0.10); --glow: rgba(240,128,90,0.35); --accent-grad: linear-gradient(135deg, #F0805A, #E25A3C); --card2: #F6EFE6; --border: rgba(47, 42, 38, 0.08); }
.popup.theme-cream { --card: #FFFDF8; --text: #3A342B; --sub: #8F8372; --accent: #E2723E; --btn-text: #FFF; --fill: rgba(120,100,80,0.10); --glow: rgba(240,148,106,0.35); --accent-grad: linear-gradient(135deg, #F0946A, #E0643A); --card2: #F3EBDE; --border: rgba(58, 52, 43, 0.09); }
.popup.theme-latte { --card: #FFFBF3; --text: #3B332A; --sub: #8F8270; --accent: #B25B2E; --btn-text: #FFF; --fill: rgba(110,90,65,0.10); --glow: rgba(203,123,76,0.35); --accent-grad: linear-gradient(135deg, #CB7B4C, #A24B22); --card2: #EFE5D6; --border: rgba(59, 51, 42, 0.09); }
.popup.theme-sage { --card: #FBFFFA; --text: #2C352A; --sub: #7D8A76; --accent: #4C8C3A; --btn-text: #FFF; --fill: rgba(80,100,70,0.10); --glow: rgba(107,168,90,0.35); --accent-grad: linear-gradient(135deg, #6BA85A, #3E7A2E); --card2: #EEF3E8; --border: rgba(44, 53, 42, 0.09); }
.popup.theme-mist { --card: #FFFFFF; --text: #26303C; --sub: #7C8998; --accent: #2F7DE1; --btn-text: #FFF; --fill: rgba(60,80,105,0.09); --glow: rgba(91,155,240,0.35); --accent-grad: linear-gradient(135deg, #5B9BF0, #2F6FD4); --card2: #F0F3F7; --border: rgba(38, 48, 60, 0.08); }
.popup.theme-dark { --card: #221C16; --text: #F2ECE3; --sub: #A29A8E; --accent: #FF8A5C; --btn-text: #1D140E; --fill: rgba(255,255,255,0.09); --glow: rgba(255,138,92,0.40); --accent-grad: linear-gradient(135deg, #FF9A70, #F0743E); --card2: #2E2720; --border: rgba(255, 255, 255, 0.09); }

/* 头像选择圈：居中、无描边，空态用淡色圆底衬托＋号 */
.avatar-btn {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: var(--fill);
  margin-bottom: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  overflow: hidden;
  transition: transform 0.18s ease;
}
.avatar-btn::after { display: none; }
.avatar-btn:active { transform: scale(0.96); }
.avatar { width: 150rpx; height: 150rpx; border-radius: 50%; display: block; }
.avatar-plus {
  font-size: 58rpx;
  color: var(--sub);
  font-weight: 200;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
}

/* 昵称：彻底居中（影响 placeholder 和实际输入内容） */
.nickname {
  width: 100%;
  margin-bottom: 30rpx;
  text-align: center;
  height: 92rpx;
  box-sizing: border-box;
  background: var(--card2);
  padding-left: 24rpx;
  padding-right: 24rpx;
  font-size: 30rpx;
  letter-spacing: 1rpx;
}

/* 立即登录：全宽主按钮（flex 强制文字双向居中） */
.confirm {
  background-color: var(--accent) !important;
  color: var(--btn-text) !important;
  width: 100%;
  height: 96rpx;
  line-height: 1;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-align: center;
  margin: 0;
  padding: 0;
  border-radius: var(--radius-btn);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx var(--glow);
}

/* 协议合规小字（微信审核需要） */
.agree {
  font-size: 21rpx;
  color: var(--sub);
  text-align: center;
  margin-top: 24rpx;
  line-height: 1.5;
}
.agree .link {
  color: var(--accent);
  margin: 0 4rpx;
}
