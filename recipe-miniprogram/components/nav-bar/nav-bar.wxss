/* 通用导航栏：滚动吸顶（同广场），毛玻璃底，标题字体随主题令牌切换 */
.nav {
  position: sticky;
  top: 0;
  z-index: 30;
  background: var(--nav-blur, rgba(255, 255, 255, 0.88));
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
}
.nav-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 标题：与广场 brand-name 同规格；可爱风（站酷快乐体）放大变轻 */
.nav-title {
  font-family: var(--font-title, inherit);
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--text, #333);
  line-height: 1.2;
  max-width: 62%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.theme-cute .nav-title { font-size: 44rpx; font-weight: 400; letter-spacing: 4rpx; }
/* 返回键：贴纸圆钮（可爱风自动勾边硬投影） */
.nav-back {
  position: absolute;
  left: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--card, #ffffff);
  border: var(--card-outline, none);
  box-shadow: var(--shadow-sm, none);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.nav-back-ico {
  font-size: 44rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--text, #333);
  margin-top: -6rpx;
}
.nav-back-press { opacity: 0.7; }
