<wxs module="fmt">
// 秒 -> mm:ss
var pad = function(n) { return (n < 10 ? '0' : '') + n; };
var time = function(s) {
  var sec = Math.max(0, Math.round(s || 0));
  return pad(Math.floor(sec / 60)) + ':' + pad(sec % 60);
};
// 进度百分比（0-100）
var pct = function(remaining, total) {
  if (!total || total <= 0) return 0;
  var p = (total - remaining) / total * 100;
  return Math.min(100, Math.max(0, Math.round(p)));
};
module.exports = { time: time, pct: pct };
</wxs>

<view class="cook-timer {{running ? 'on' : ''}} {{finished ? 'done' : ''}}">
  <!-- 常驻一行：时间数字原地跳动（点数字可加时），右侧开始/暂停 -->
  <view class="ct-row">
    <view class="ct-time" hover-class="{{started && !finished ? 'ct-time-hover' : ''}}" bindtap="onTimeTap">
      {{fmt.time(started ? remaining : customSec)}}<text wx:if="{{started && !finished}}" class="ct-add">＋</text>
    </view>
    <view class="ct-state">
      <text wx:if="{{finished}}">✓ 完成</text>
      <text wx:elif="{{running}}">计时中</text>
      <text wx:elif="{{started}}">已暂停</text>
      <text wx:else>建议 {{hintText}}</text>
    </view>
    <button wx:if="{{!finished}}" class="t-btn main" bindtap="{{running ? 'pause' : (started ? 'resume' : 'start')}}" hover-class="t-hover">
      {{running ? '暂停' : (started ? '继续' : '开始')}}
    </button>
    <button wx:else class="t-btn main" bindtap="reset" hover-class="t-hover">重置</button>
  </view>

  <!-- 进度条：常驻（未开始为空轨），不再切换区块 -->
  <view class="progress-track">
    <view class="progress-bar" style="width: {{fmt.pct(remaining, totalSec)}}%;"></view>
  </view>
</view>
