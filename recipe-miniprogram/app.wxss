/**
 * ===== 菜谱小程序 · 设计系统 =====
 * 全局 CSS 变量按主题定义在 .page.theme-* 下，页面根节点 <view class="page theme-{{theme}}">
 * 8 套主题：cute(可爱风·皮肤) / clean(简洁风·皮肤) + 6 套经典配色
 * light(暖白·默认) / cream(奶油) / latte(奶咖) / sage(浅绿) / mist(雾蓝) / dark(深色)
 * 经典配色沿用「温馨厨房」语言（陶土橙 + 大圆角 + 柔和阴影）；
 * cute / clean 为完整皮肤：同时覆盖色彩与形状令牌（圆角/描边/阴影/按钮形态）
 */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
  color: #2F2A26;
}

/* ===== 主题变量 ===== */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  /* 形状令牌基线（经典配色系共用；皮肤主题在各自块内覆盖） */
  --radius-lg: 40rpx;
  --radius-card: 32rpx;
  --radius-md: 24rpx;
  --radius-sm: 16rpx;
  --radius-btn: 999rpx;
  --radius-input: 20rpx;
  --radius-tag: 999rpx;
  --card-outline: 1rpx solid rgba(255, 255, 255, 0.55);
  --btn-primary-bg: var(--accent-grad);
  --btn-primary-text: var(--btn-text);
  --btn-primary-border: 0;
  --btn-primary-shadow: 0 10rpx 28rpx var(--glow);
  --star: #F5A623;
  /* 标题字体：可爱风换手写体（loadFontFace 加载失败自动降级苹方） */
  --font-title: inherit;
}

/* ===== 皮肤：可爱风「软软食堂」 =====
 * 贴纸手账语言：白卡 + 深可可勾边 + 硬投影，草莓粉渐变主按钮，奶油甜点色系 */
.page.theme-cute {
  --bg: #FFF6EF;
  --card: #FFFFFF;
  --card2: #FBEFE6;
  --text: #4E2B36;
  --sub: #A9868F;
  --border: #EAD2D8;
  --accent: #F4577C;
  --accent-weak: #FFDCE3;
  --btn-text: #FFFFFF;
  --fill: #FBEFE6;
  --danger: #E94B6A;
  --danger-weak: #FFDDE4;
  --warn: #D97F1F;
  --warn-weak: #FFF0C9;
  --ok: #1FA97D;
  --ok-weak: #DCF6ED;
  --info: #4A90C9;
  --info-weak: #DCECFF;
  --shadow: 8rpx 8rpx 0 rgba(78, 43, 54, 0.10);
  --shadow-sm: 4rpx 4rpx 0 rgba(78, 43, 54, 0.10);
  --shadow-lg: 12rpx 12rpx 0 rgba(78, 43, 54, 0.14);
  --nav-blur: rgba(255, 246, 239, 0.88);
  --accent-grad: linear-gradient(135deg, #FFA3B8 0%, #FF6E8E 100%);
  --accent-grad-soft: linear-gradient(135deg, rgba(255, 163, 184, 0.20) 0%, rgba(255, 110, 142, 0.20) 100%);
  --cover-grad: linear-gradient(180deg, rgba(78, 43, 54, 0) 45%, rgba(78, 43, 54, 0.52) 100%);
  --glow: rgba(255, 110, 142, 0.32);
  /* 形状令牌：更大圆角 + 深色勾边 + 胶囊输入 */
  --radius-lg: 52rpx;
  --radius-card: 44rpx;
  --radius-md: 36rpx;
  --radius-sm: 28rpx;
  --radius-btn: 999rpx;
  --radius-input: 28rpx;
  --radius-tag: 999rpx;
  --card-outline: 3rpx solid #4E2B36;
  --btn-primary-bg: linear-gradient(135deg, #FFA3B8 0%, #FF6E8E 100%);
  --btn-primary-text: #FFFFFF;
  --btn-primary-border: 3rpx solid #4E2B36;
  --btn-primary-shadow: 5rpx 5rpx 0 rgba(78, 43, 54, 0.18);
  --star: #FFB53C;
  --font-title: 'ZCOOL KuaiLe', 'PingFang SC', 'Hiragino Sans GB', sans-serif;
  /* 奶油底 + 草莓波点纹理 */
  background-color: #FFF6EF;
  background-image: radial-gradient(rgba(255, 110, 142, 0.10) 4rpx, transparent 4rpx);
  background-size: 56rpx 56rpx;
  background-position: 0 0;
}

/* ===== 皮肤：简洁干练风「厨房手记」 =====
 * 编辑部手记语言：细线分割 + 小圆角 + 黑底主按钮，暖灰底 + 焦橙点缀 */
.page.theme-clean {
  --bg: #F5F4F2;
  --card: #FFFFFF;
  --card2: #F0EEEB;
  --text: #1B1A18;
  --sub: #7A7670;
  --border: rgba(27, 26, 24, 0.10);
  --accent: #C2410C;
  --accent-weak: #FBEDE4;
  --btn-text: #FFFFFF;
  --fill: #F0EEEB;
  --danger: #C03526;
  --danger-weak: rgba(192, 53, 38, 0.10);
  --warn: #A16207;
  --warn-weak: rgba(161, 98, 7, 0.12);
  --ok: #1F7A4D;
  --ok-weak: rgba(31, 122, 77, 0.10);
  --info: #3E6B99;
  --info-weak: rgba(62, 107, 153, 0.10);
  --shadow: 0 8rpx 24rpx rgba(20, 19, 18, 0.06);
  --shadow-sm: 0 2rpx 8rpx rgba(20, 19, 18, 0.05);
  --shadow-lg: 0 16rpx 48rpx rgba(20, 19, 18, 0.12);
  --nav-blur: rgba(245, 244, 242, 0.88);
  --accent-grad: linear-gradient(135deg, #D2551F 0%, #B23A06 100%);
  --accent-grad-soft: linear-gradient(135deg, rgba(194, 65, 12, 0.12) 0%, rgba(178, 58, 6, 0.12) 100%);
  --cover-grad: linear-gradient(180deg, rgba(20, 19, 18, 0) 45%, rgba(20, 19, 18, 0.55) 100%);
  --glow: rgba(194, 65, 12, 0.22);
  /* 形状令牌：小圆角 + 细边 + 方角按钮 */
  --radius-lg: 24rpx;
  --radius-card: 16rpx;
  --radius-md: 12rpx;
  --radius-sm: 8rpx;
  --radius-btn: 12rpx;
  --radius-input: 12rpx;
  --radius-tag: 8rpx;
  --card-outline: 1rpx solid rgba(27, 26, 24, 0.08);
  --btn-primary-bg: #171614;
  --btn-primary-text: #FFFFFF;
  --btn-primary-border: 0;
  --btn-primary-shadow: none;
  --star: #D99128;
}

/* ===== 皮肤自选背景（皮肤主题下叠加 bg-glass / bg-pink 类） ===== */
/* 可爱风 · 磨砂玻璃：奶白底 + 白色光泽渐变，波点更淡 */
.page.theme-cute.bg-glass {
  --bg: #FCF1F4;
  --nav-blur: rgba(252, 241, 244, 0.88);
  background-color: #FCF1F4;
  background-image:
    radial-gradient(circle at 18% 8%, rgba(255, 255, 255, 0.85), transparent 44%),
    radial-gradient(circle at 85% 94%, rgba(255, 255, 255, 0.60), transparent 38%),
    radial-gradient(rgba(255, 110, 142, 0.06) 4rpx, transparent 4rpx);
  background-size: 100% 100%, 100% 100%, 56rpx 56rpx;
  background-repeat: no-repeat, no-repeat, repeat;
}
/* 可爱风 · 淡粉：草莓淡粉底 + 加浓波点 */
.page.theme-cute.bg-pink {
  --bg: #FFE4EC;
  --nav-blur: rgba(255, 228, 236, 0.88);
  background-color: #FFE4EC;
  background-image: radial-gradient(rgba(255, 110, 142, 0.14) 4rpx, transparent 4rpx);
  background-size: 56rpx 56rpx;
}
/* 简洁风 · 磨砂玻璃：冷调浅灰 + 白色光泽 */
.page.theme-clean.bg-glass {
  --bg: #EFF1F4;
  --nav-blur: rgba(239, 241, 244, 0.88);
  background-color: #EFF1F4;
  background-image:
    radial-gradient(circle at 20% 10%, rgba(255, 255, 255, 0.80), transparent 46%),
    linear-gradient(160deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.06));
}
/* 简洁风 · 淡粉：编辑手记风的柔和粉底 */
.page.theme-clean.bg-pink {
  --bg: #FAEBF0;
  --nav-blur: rgba(250, 235, 240, 0.88);
  background-color: #FAEBF0;
}

