/* ===== 页面容器 ===== */
.page-content {
  padding: 16rpx 28rpx 200rpx;
  box-sizing: border-box;
}

/* 通用页头（问候/标题） */
.page-header {
  padding: 28rpx 8rpx 24rpx;
}
.page-header .h-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 1rpx;
  line-height: 1.3;
  font-family: var(--font-title);
}
.page-header .h-sub {
  font-size: 26rpx;
  color: var(--sub);
  margin-top: 10rpx;
  line-height: 1.5;
}
/* 只留副标语（标题在自定义导航栏）：去掉相对标题的缩进 */
.page-header.header-only-sub .h-sub { margin-top: 0; }

/* 分区标题 */
.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin: 8rpx 4rpx 20rpx;
  letter-spacing: 1rpx;
  font-family: var(--font-title);
}
.section-head::before {
  content: '';
  width: 10rpx;
  height: 32rpx;
  border-radius: 6rpx;
  background: var(--accent-grad);
  flex-shrink: 0;
}

/* ===== 卡片（形状令牌驱动：经典=柔和大圆角 / 可爱=勾边贴纸 / 简洁=细线小圆角） ===== */
.card {
  background: var(--card);
  border-radius: var(--radius-card);
  padding: 32rpx;
  margin: 20rpx 0;
  box-shadow: var(--shadow);
  border: var(--card-outline);
}
.card.grouped {
  margin: 20rpx 0;
  overflow: hidden;
  padding: 0;
  border: none;
}
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
  background: var(--card);
}
.cell:last-child { border-bottom: none; }
.cell-label { font-size: 29rpx; color: var(--text); font-weight: 500; }
.cell-value { font-size: 28rpx; color: var(--sub); display: flex; align-items: center; }

/* ===== 按钮（形状令牌驱动：经典/可爱=渐变胶囊 / 简洁=黑底方角） ===== */
.btn {
  border-radius: var(--radius-btn);
  font-size: 30rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  padding: 0 44rpx;
  box-sizing: border-box;
  transition: all 0.18s ease;
  letter-spacing: 1rpx;
}
.btn::after { border: none; }
.btn:active { opacity: 0.82; transform: scale(0.98); }
.btn-primary {
  background: var(--btn-primary-bg);
  color: var(--btn-primary-text);
  border: var(--btn-primary-border);
  box-shadow: var(--btn-primary-shadow);
}
.btn-plain {
  background: transparent;
  color: var(--accent);
  border: 2rpx solid var(--accent);
  line-height: 88rpx;
}
.btn-ghost {
  background: var(--fill);
  color: var(--text);
}
.btn[disabled] { opacity: 0.4; box-shadow: none; }

/* 胶囊小按钮 */
.btn-sm {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  line-height: 1;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 500;
}
.btn-sm::after { border: none; }
.btn-sm.primary { background: var(--btn-primary-bg); color: var(--btn-primary-text); box-shadow: var(--btn-primary-shadow); border: var(--btn-primary-border); }
.btn-sm.ghost { background: var(--fill); color: var(--text); }
.btn-sm.outline { border: 2rpx solid var(--accent); color: var(--accent); background: transparent; }

/* ===== 输入 ===== */
.input {
  background: var(--fill);
  border-radius: var(--radius-input);
  padding: 24rpx 30rpx;
  font-size: 29rpx;
  color: var(--text);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}
.input::placeholder { color: var(--sub); }
.input.ios-search {
  border-radius: 999rpx;
  background: var(--fill);
  font-size: 29rpx;
  padding: 22rpx 34rpx;
}

/* ===== 标签（胶囊） ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 22rpx;
  border-radius: var(--radius-tag);
  font-size: 22rpx;
  font-weight: 500;
  margin-right: 12rpx;
  letter-spacing: 0.5rpx;
}
.tag-red { background: var(--danger-weak); color: var(--danger); }
.tag-orange { background: var(--warn-weak); color: var(--warn); }
.tag-green { background: var(--ok-weak); color: var(--ok); }
.tag-blue { background: var(--info-weak); color: var(--info); }
.tag-plain { background: var(--fill); color: var(--sub); }
/* 可编辑态标签（作者可见范围等）：虚线描边 + 按压反馈 */
.tag-edit { border: 1.5rpx dashed var(--accent); padding: 6.5rpx 20rpx; }
.tag-edit:active { opacity: 0.6; }

/* ===== 空态 ===== */
.empty {
  text-align: center;
  color: var(--sub);
  padding: 140rpx 40rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.empty-icon {
  font-size: 88rpx;
  display: block;
  margin-bottom: 24rpx;
  opacity: 0.6;
}
.empty small { font-size: 24rpx; }

/* ===== 弹层 ===== */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(30, 20, 12, 0.45);
  z-index: 99;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 44rpx 40rpx calc(44rpx + env(safe-area-inset-bottom));
  z-index: 100;
  animation: sheet-up 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -20rpx 60rpx rgba(40, 25, 12, 0.14);
}
@keyframes sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.center-dialog {
  background: var(--card);
  border-radius: var(--radius-card);
  padding: 44rpx;
  width: 600rpx;
  box-shadow: var(--shadow-lg);
}

/* 分段选择（胶囊 segmented） */
.seg {
  display: flex;
  background: var(--fill);
  border-radius: var(--radius-btn);
  padding: 8rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 27rpx;
  color: var(--sub);
  border-radius: var(--radius-tag);
  transition: all 0.22s ease;
}
.seg-item.active {
  background: var(--card);
  color: var(--text);
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(120, 90, 60, 0.14);
}

/* 列表项 */
.row-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.row-item:last-child { border-bottom: none; }

/* 卡片内标题 */
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 22rpx;
  letter-spacing: 1rpx;
  font-family: var(--font-title);
}

/* 通用弹层标题 / 底部按钮 */
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  text-align: center;
  margin-bottom: 32rpx;
  letter-spacing: 1rpx;
  font-family: var(--font-title);
}
.sheet-close { width: 100%; }
.sheet-btn { width: 100%; margin-top: 40rpx; }
.sheet-sub {
  font-size: 22rpx;
  color: var(--sub);
  text-align: center;
  margin: -18rpx 0 26rpx;
  letter-spacing: 0.5rpx;
}

/* ===== 邀请弹层（队伍 / 冰箱共用） ===== */
/* view 卡（承载视觉）；分享卡内含透明 button 覆盖层（.inv-share-btn）承担点击 */
.inv-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  height: 148rpx;
  padding: 0 26rpx;
  background: var(--fill);
  border: var(--card-outline);
  border-radius: var(--radius-card);
  margin-bottom: 20rpx;
  text-align: left;
  line-height: 1.5;
  font-size: inherit;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  transition: transform 0.15s ease;
}
button.inv-card {
  /* 已废弃：覆盖层模式下 button 不再承担卡片外形（见 .inv-share-btn），
     规则保留防御其他场景误用 class 组合 */
  display: none;
}
.inv-card.share { background: var(--accent-grad-soft); }
.inv-share-btn {
  /* 分享覆盖层：铺满整张卡片的透明 button——view 负责视觉，button 只负责触发 share。
     UA 的 line-height/padding/font-size 全部清零，高度由 100% 决定，不再受默认样式干扰 */
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  margin: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  line-height: 1 !important;
  font-size: 0 !important;
  color: transparent !important;
  overflow: hidden !important;
  z-index: 3;
}
.inv-press { transform: scale(0.98); opacity: 0.9; }
.inv-ic {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  flex-shrink: 0;
  background: var(--card);
}
.inv-main { flex: 1; min-width: 0; }
.inv-name { font-size: 29rpx; font-weight: 700; color: var(--text); }
.inv-desc { font-size: 22rpx; color: var(--sub); margin-top: 6rpx; }
.inv-chev {
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid var(--sub);
  border-bottom: 4rpx solid var(--sub);
  transform: rotate(45deg);
  transition: transform 0.2s ease;
  flex-shrink: 0;
  opacity: 0.6;
}
.inv-chev.open { transform: rotate(225deg); }
.inv-go {
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid var(--accent);
  border-bottom: 4rpx solid var(--accent);
  transform: rotate(-45deg);
  flex-shrink: 0;
  opacity: 0.85;
}

/* 展开面板：有效期分段选择 + 生成按钮 + 邀请码票据 */
.inv-panel { padding: 2rpx 4rpx 6rpx; }
.inv-panel-row { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }
.inv-panel-label { font-size: 25rpx; color: var(--sub); font-weight: 500; flex-shrink: 0; }
.seg {
  flex: 1;
  display: flex;
  gap: 6rpx;
  background: var(--fill);
  border-radius: var(--radius-btn);
  padding: 6rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--sub);
  font-weight: 600;
  padding: 12rpx 0;
  border-radius: var(--radius-btn);
  line-height: 1.4;
  box-sizing: border-box;
  transition: background 0.15s ease, color 0.15s ease;
}
.seg-item.active {
  background: var(--card);
  color: var(--accent);
  font-weight: 700;
  box-shadow: var(--shadow-sm);
}
.inv-gen { margin-top: 4rpx; }

/* 邀请码票据：虚线边 + 大号码 + 点击复制 */
.ticket {
  margin-top: 20rpx;
  border: 2rpx dashed var(--accent);
  border-radius: var(--radius-md);
  background: var(--card2);
  padding: 32rpx 24rpx 24rpx;
  text-align: center;
  transition: transform 0.15s ease;
}
.ticket-press { transform: scale(0.97); }
.tk-code {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: var(--accent);
  font-family: 'DIN Alternate', -apple-system, monospace;
  word-break: break-all;
}
.tk-meta { font-size: 22rpx; color: var(--sub); margin-top: 12rpx; }
.tk-hint { font-size: 20rpx; color: var(--accent); opacity: 0.75; margin-top: 12rpx; letter-spacing: 2rpx; }

/* 邀请与输码加入的分隔 */
.inv-divider {
  border-top: 2rpx dashed var(--border);
  margin: 28rpx 0 4rpx;
}

/* 按压反馈 */
.pressed { opacity: 0.85; }

/* ===== 皮肤细节 · 可爱风「软软食堂」 ===== */
/* 主按钮加勾边后修正文字行高 */
.page.theme-cute .btn-primary { line-height: 86rpx; }
/* 描边按钮：白底 + 可可勾边 + 硬投影 */
.page.theme-cute .btn-plain {
  background: #FFFFFF;
  border: 3rpx solid #4E2B36;
  line-height: 86rpx;
  box-shadow: 4rpx 4rpx 0 rgba(78, 43, 54, 0.12);
}
.page.theme-cute .btn-sm.outline { border: 2rpx solid #4E2B36; color: #F4577C; }
/* 分组分隔：虚线缝纫感 */
.page.theme-cute .cell { border-bottom: 2rpx dashed var(--border); }
.page.theme-cute .row-item { border-bottom: 2rpx dashed var(--border); }
/* 分组卡保留贴纸勾边 */
.page.theme-cute .card.grouped { border: var(--card-outline); }
/* 分区标题竖条变圆豆 */
.page.theme-cute .section-head::before { border-radius: 999rpx; }
/* 可编辑标签加深虚线 */
.page.theme-cute .tag-edit { border: 2rpx dashed var(--accent); }
/* 分段选中态：勾边贴纸 */
.page.theme-cute .seg-item.active {
  border: 2rpx dashed var(--accent);
  box-shadow: 3rpx 3rpx 0 rgba(78, 43, 54, 0.10);
}
/* 邀请码票据：贴纸化虚线 + 硬投影 */
.page.theme-cute .ticket {
  border-width: 3rpx;
  box-shadow: 4rpx 4rpx 0 rgba(78, 43, 54, 0.10);
}
/* 输入聚焦：可可勾边 */
.page.theme-cute .input:focus { border-color: #4E2B36; }

/* ===== 皮肤细节 · 简洁风「厨房手记」 ===== */
/* 数字等宽对齐（计时/热量/统计） */
.page.theme-clean { font-variant-numeric: tabular-nums; }
/* 分区标题竖条变细杠 */
.page.theme-clean .section-head::before { width: 6rpx; height: 28rpx; border-radius: 2rpx; }
/* 分段选中态：细边浮层 */
.page.theme-clean .seg-item.active {
  border: 1rpx solid var(--border);
  box-shadow: 0 1rpx 4rpx rgba(20, 19, 18, 0.06);
}
/* 描边按钮收细 */
.page.theme-clean .btn-plain { border-width: 1rpx; line-height: 90rpx; }
/* 弹层顶边细线 */
.page.theme-clean .sheet { box-shadow: 0 -12rpx 48rpx rgba(20, 19, 18, 0.10); }
/* 卡片去白描边残留，仅细线 */
.page.theme-clean .card.grouped { border: var(--card-outline); }
